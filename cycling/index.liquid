---
layout: default
title: Cycling
---

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<link rel="stylesheet" href="/assets/cycling.css">

<h1 class="page-title">Kevin Cycles</h1>
<p class="page-intro">
  <a href="/bicycles/">Bicycles &rarr;</a>
</p>

{% rideSummary rides.rides %}

<h2 class="section-title" id="everystreet">
    <span>#everystreet — Regina, SK</span>
    {% everystreetThumb %}
    <a class="map-link" href="/everystreet/map.html" target="_blank" rel="noopener">Open&nbsp;↗</a>
</h2>
<div class="everystreet-map">
    <div id="map" class="maplibre-map"></div>
</div>
<p class="everystreet-attribution">
    Street data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a> &middot; coverage via <a href="https://osmnx.readthedocs.io/" target="_blank" rel="noopener">OSMnx</a> &middot; #everystreet
</p>
<div class="everystreet-mini">
    <div class="ring">
        <svg class="ring-svg" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="ring-bg" cx="60" cy="60" r="52"/>
            <circle class="ring-fg" cx="60" cy="60" r="52" pathLength="100" style="stroke-dasharray: {{ everystreet.pct_complete }} 100"/>
        </svg>
        <div class="ring-center">
            <strong>{{ everystreet.pct_complete }}%</strong>
            <span>complete</span>
        </div>
    </div>
    <div class="everystreet-stats">
        <div><span class="stat-label">Ridden</span><strong>{{ everystreet.ridden_km }} km</strong></div>
        <div><span class="stat-label">Missing</span><strong>{{ everystreet.missing_km }} km</strong></div>
        <div><span class="stat-label">Total</span><strong>{{ everystreet.total_km }} km</strong></div>
        <div><span class="stat-label">Rides</span><strong>{{ everystreet.rides }}</strong></div>
    </div>
</div>

<h2 class="section-title" id="rides">Rides</h2>
{% yearFilter rides.rides %}
{% rideTable rides.rides %}

<h2 class="section-title">Activity heatmap</h2>
{% heatmap rides.rides %}

{% ridesData rides.rides %}

<script defer src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script defer src="/assets/map.js"></script>
<script defer src="/assets/cycling.js"></script>
